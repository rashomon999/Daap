<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Donaciones Transparentes — Demo blockchain</title>
  <style>
    :root {
      --bg: #0f1117;
      --card: #1a1d27;
      --border: #2a2e3d;
      --text: #e8eaf0;
      --muted: #9aa0b0;
      --accent: #34d399;
      --accent-hover: #4ee0ae;
      --accent2: #6c8cff;
      --ok: #4ade80;
      --err: #f87171;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      padding: 2rem 1rem;
    }
    .container { max-width: 720px; margin: 0 auto; }
    h1 { font-size: 1.6rem; margin-bottom: .25rem; }
    .subtitle { color: var(--muted); margin-bottom: 1.5rem; font-size: .95rem; }
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.25rem;
      margin-bottom: 1rem;
    }
    button {
      background: var(--accent2);
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: .65rem 1.2rem;
      font-size: .95rem;
      font-weight: 600;
      cursor: pointer;
      transition: background .15s;
    }
    button.donate { background: var(--accent); color: #06281c; }
    button:hover { filter: brightness(1.1); }
    button:disabled { opacity: .5; cursor: not-allowed; }
    input, textarea {
      width: 100%;
      background: var(--bg);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: .65rem .75rem;
      font-size: .95rem;
      font-family: inherit;
      margin-bottom: .6rem;
    }
    input:focus, textarea:focus { outline: 2px solid var(--accent2); border-color: transparent; }
    .row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
    .account {
      font-family: ui-monospace, monospace;
      font-size: .85rem;
      color: var(--muted);
      word-break: break-all;
    }
    .status { font-size: .9rem; margin-top: .5rem; min-height: 1.2rem; }
    .status.ok { color: var(--ok); }
    .status.err { color: var(--err); }

    .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; }
    .stat { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: .9rem; text-align: center; }
    .stat .value { font-size: 1.3rem; font-weight: 700; }
    .stat .label { font-size: .75rem; color: var(--muted); margin-top: .2rem; }
    .stat.donated .value { color: var(--accent); }
    .stat.withdrawn .value { color: #fbbf24; }
    .stat.balance .value { color: var(--accent2); }
    .formula {
      font-family: ui-monospace, monospace;
      font-size: .8rem;
      color: var(--muted);
      text-align: center;
      margin-top: .75rem;
    }

    .entry { border-bottom: 1px solid var(--border); padding: .8rem 0; }
    .entry:last-child { border-bottom: none; }
    .entry .top { display: flex; justify-content: space-between; font-size: .8rem; }
    .entry .who { font-family: ui-monospace, monospace; color: var(--accent2); }
    .entry .amount { font-weight: 700; }
    .entry.withdrawal .amount { color: #fbbf24; }
    .entry.donation .amount { color: var(--accent); }
    .entry .msg { margin-top: .3rem; font-size: .95rem; }
    .entry .time { font-size: .75rem; color: var(--muted); margin-top: .2rem; }
    .empty { color: var(--muted); text-align: center; padding: 1.2rem 0; font-size: .9rem; }

    .tabs { display: flex; gap: .5rem; margin-bottom: .75rem; }
    .tab-btn {
      background: transparent; border: 1px solid var(--border); color: var(--muted);
      padding: .4rem .9rem; border-radius: 20px; font-size: .85rem; font-weight: 500;
    }
    .tab-btn.active { background: var(--accent2); color: #fff; border-color: var(--accent2); }

    .admin-badge {
      display: inline-block; background: #422006; color: #fbbf24;
      font-size: .75rem; padding: .2rem .6rem; border-radius: 12px; margin-left: .5rem;
    }
    .hidden { display: none; }
  </style>
</head>
<body>
  <div class="container">
    <h1>💚 Donaciones Transparentes</h1>
    <p class="subtitle" id="causeSubtitle" style="margin-bottom:1.5rem;">Demo: toda donación y todo retiro quedan públicamente registrados en la blockchain.</p>

    <!-- Conectar wallet -->
    <div class="card">
      <div class="row">
        <button id="connectBtn">🦊 Conectar wallet</button>
        <span class="account" id="account">No conectado</span>
      </div>
      <div class="status" id="connectStatus"></div>
    </div>

    <!-- Estadísticas: el corazón de la transparencia -->
    <div class="card">
      <div class="stats">
        <div class="stat donated">
          <div class="value" id="totalDonated">0</div>
          <div class="label">ETH donados</div>
        </div>
        <div class="stat withdrawn">
          <div class="value" id="totalWithdrawn">0</div>
          <div class="label">ETH retirados</div>
        </div>
        <div class="stat balance">
          <div class="value" id="balance">0</div>
          <div class="label">ETH en el contrato</div>
        </div>
      </div>
      <div class="formula">donado − retirado = balance · verificable por cualquiera en Etherscan</div>
    </div>

    <!-- Donar -->
    <div class="card">
      <h3 style="margin-bottom:.6rem; font-size:1rem;">Hacer una donación</h3>
      <input type="number" id="donateAmount" step="0.001" min="0" placeholder="Cantidad en ETH (ej. 0.01)" />
      <textarea id="donateMessage" maxlength="140" placeholder="Mensaje opcional..." style="min-height:60px;"></textarea>
      <button class="donate" id="donateBtn" disabled>💚 Donar</button>
      <div class="status" id="donateStatus"></div>
    </div>

    <!-- Panel de la ONG (solo visible si la wallet conectada es la ONG) -->
    <div class="card hidden" id="ngoPanel">
      <h3 style="margin-bottom:.6rem; font-size:1rem;">Panel de la ONG <span class="admin-badge">solo visible para ti</span></h3>
      <input type="number" id="withdrawAmount" step="0.001" min="0" placeholder="Cantidad a retirar en ETH" />
      <input type="text" id="withdrawReason" placeholder="Razón obligatoria (ej. Compra de 200 almuerzos)" />
      <button id="withdrawBtn">📤 Retirar fondos</button>
      <div class="status" id="withdrawStatus"></div>
    </div>

    <!-- Historial -->
    <div class="card">
      <div class="tabs">
        <button class="tab-btn active" data-tab="donations">Donaciones (<span id="donationCount">0</span>)</button>
        <button class="tab-btn" data-tab="withdrawals">Retiros (<span id="withdrawalCount">0</span>)</button>
      </div>
      <button id="refreshBtn" style="margin-bottom:.75rem;">🔄 Actualizar</button>
      <div id="donationsList"></div>
      <div id="withdrawalsList" class="hidden"></div>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/ethers/6.13.4/ethers.umd.min.js"></script>
  <script src="donaciones.js"></script>
</body>
</html>
