# Copia este archivo a ".env" (sin el ".example") y rellena tus valores.
# ".env" NUNCA se sube a git ni se comparte — mira .gitignore.
#
# Este archivo solo se usa para desplegar en Sepolia. Para la red local
# (npx hardhat node) no hace falta nada de esto.

# URL de tu app de Alchemy → dashboard.alchemy.com → tu app → "View Key" → "HTTPS"
# Debe verse como: https://eth-sepolia.g.alchemy.com/v2/TU_API_KEY
ALCHEMY_SEPOLIA_URL=

# Llave privada de tu cuenta NUEVA de MetaMask, dedicada SOLO a desplegar en testnet.
# ⚠️ NUNCA uses la llave de una wallet con fondos reales.
# ⚠️ NUNCA subas este archivo a git ni lo compartas por chat/Slack/email.
# Cómo obtenerla: MetaMask → selecciona la cuenta nueva → los 3 puntos →
#   "Detalles de la cuenta" → "Mostrar clave privada" → tu contraseña de MetaMask.
DEPLOYER_PRIVATE_KEY=
